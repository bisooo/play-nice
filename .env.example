# Copy to .env.local. Never put real values in this file.

# Spotify app (developer.spotify.com/dashboard). Redirect URI (only used by
# scripts/spotify-refresh-token.mjs): http://127.0.0.1:3000/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# The account whose listening the app shows. Get it with
# `node scripts/spotify-refresh-token.mjs` on your machine; lasts 6 months.
SPOTIFY_REFRESH_TOKEN=

# MongoDB connection string (use a separate database for testing)
DATABASE_URL=
