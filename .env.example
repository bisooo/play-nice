# Copy to .env.local. Never put real values in this file.

# Spotify app (developer.spotify.com/dashboard). Redirect URI:
# http://127.0.0.1:3000/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# NextAuth: generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=
# Must use 127.0.0.1, not localhost (Spotify rejects localhost redirect URIs)
NEXTAUTH_URL=http://127.0.0.1:3000

# MongoDB connection string (use a separate database for testing)
DATABASE_URL=
