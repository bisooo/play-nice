# Copy to .env.local. Never put real values in this file.

# Spotify app (developer.spotify.com/dashboard). Redirect URI:
# http://127.0.0.1:3000/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# NextAuth: generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=
# Must use 127.0.0.1, not localhost (Spotify rejects localhost redirect URIs)
NEXTAUTH_URL=http://127.0.0.1:3000

# MongoDB connection string (use a separate database for testing)
DATABASE_URL=

# Cloud sessions only: dev login at /api/dev/login (no Spotify login page needed).
# Get it with `node scripts/spotify-refresh-token.mjs` on your machine; lasts 6 months.
# Only works when NEXTAUTH_URL and DATABASE_URL are on 127.0.0.1/localhost. Never set on Vercel.
DEV_SPOTIFY_REFRESH_TOKEN=
