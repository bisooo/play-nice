// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User model to store Spotify user and authentication details
model User {
  id                 String      @id @default(auto()) @map("_id") @db.ObjectId
  spotifyId          String      @unique
  email              String?
  name               String?
  accessToken        String?
  refreshToken       String?
  accessTokenExpires DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  topArtists         TopArtist[]
  topTracks          TopTrack[]
  lastTopItemsUpdate DateTime?
}

model TopArtist {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  spotifyId  String
  name       String
  imageUrl   String?
  popularity Int?
  genres     String[]
  timeRange  TimeRange
  rank       Int
  user       User      @relation(fields: [userId], references: [id])
  userId     String    @db.ObjectId
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, spotifyId, timeRange])
  @@index([userId, timeRange])
}

model TopTrack {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  spotifyId  String
  name       String
  artistName String
  albumName  String?
  imageUrl   String?
  popularity Int?
  timeRange  TimeRange
  rank       Int
  user       User      @relation(fields: [userId], references: [id])
  userId     String    @db.ObjectId
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, spotifyId, timeRange])
  @@index([userId, timeRange])
}

// History: append-only, never rewritten. TopArtist/TopTrack above hold only the latest
// lists; these keep every sync's lists and every play so stats can look back in time.

// One document per sync and time range: the top artists exactly as Spotify ranked them then
model TopArtistSnapshot {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  userId     String           @db.ObjectId
  timeRange  TimeRange
  capturedAt DateTime
  items      SnapshotArtist[]

  @@unique([userId, timeRange, capturedAt])
  @@index([userId, capturedAt])
}

type SnapshotArtist {
  spotifyId String
  name      String
  imageUrl  String?
  genres    String[]
  rank      Int
}

model TopTrackSnapshot {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  userId     String          @db.ObjectId
  timeRange  TimeRange
  capturedAt DateTime
  items      SnapshotTrack[]

  @@unique([userId, timeRange, capturedAt])
  @@index([userId, capturedAt])
}

type SnapshotTrack {
  spotifyId String
  name      String
  artists   PlayArtist[]
  albumName String?
  imageUrl  String?
  rank      Int
}

// One document per play. playedAt is when the track finished (Spotify's played_at).
model Play {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  userId      String       @db.ObjectId
  playedAt    DateTime
  trackId     String
  trackName   String
  artists     PlayArtist[]
  albumId     String?
  albumName   String?
  imageUrl    String?
  durationMs  Int?
  contextType String?
  contextUri  String?
  source      PlaySource

  @@unique([userId, playedAt])
  @@index([userId, trackId])
}

type PlayArtist {
  spotifyId String
  name      String
}

enum PlaySource {
  RECENTLY_PLAYED
  EXPORT
}

enum TimeRange {
  SHORT_TERM
  MEDIUM_TERM
  LONG_TERM
}
