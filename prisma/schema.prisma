// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User model to store Spotify user and authentication details
model User {
  id                 String      @id @default(auto()) @map("_id") @db.ObjectId
  spotifyId          String      @unique
  email              String?
  name               String?
  accessToken        String?
  refreshToken       String?
  accessTokenExpires DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  topArtists         TopArtist[]
  topTracks          TopTrack[]
  lastTopItemsUpdate DateTime?
}

model TopArtist {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  spotifyId  String
  name       String
  imageUrl   String?
  popularity Int?
  genres     String[]
  timeRange  TimeRange
  rank       Int
  user       User      @relation(fields: [userId], references: [id])
  userId     String    @db.ObjectId
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, spotifyId, timeRange])
  @@index([userId, timeRange])
}

model TopTrack {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  spotifyId  String
  name       String
  artistName String
  albumName  String?
  imageUrl   String?
  popularity Int?
  timeRange  TimeRange
  rank       Int
  user       User      @relation(fields: [userId], references: [id])
  userId     String    @db.ObjectId
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, spotifyId, timeRange])
  @@index([userId, timeRange])
}

// History: append-only, never rewritten. TopArtist/TopTrack above hold only the latest
// lists; these keep every sync's lists and every play so stats can look back in time.

// One document per sync and time range: the top artists exactly as Spotify ranked them then
model TopArtistSnapshot {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  userId     String           @db.ObjectId
  timeRange  TimeRange
  capturedAt DateTime
  items      SnapshotArtist[]

  @@unique([userId, timeRange, capturedAt])
  @@index([userId, capturedAt])
}

type SnapshotArtist {
  spotifyId String
  name      String
  imageUrl  String?
  genres    String[]
  rank      Int
}

model TopTrackSnapshot {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  userId     String          @db.ObjectId
  timeRange  TimeRange
  capturedAt DateTime
  items      SnapshotTrack[]

  @@unique([userId, timeRange, capturedAt])
  @@index([userId, capturedAt])
}

type SnapshotTrack {
  spotifyId String
  name      String
  artists   PlayArtist[]
  albumName String?
  imageUrl  String?
  rank      Int
}

// Listening history = Play (one per listen) + catalog (Track, Artist, Album, one per thing).
// A play stores only what's true of that listen and points at its Track by Spotify id;
// names, artists, covers and genres live once in the catalog. See docs/data-model.md.

// playedAt is when the play ended (Spotify's played_at / the export's ts), in UTC.
model Play {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  userId            String     @db.ObjectId
  playedAt          DateTime
  trackId           String
  // Time actually listened. Exact for EXPORT; for RECENTLY_PLAYED estimated as the time
  // since the previous play, capped at the track's length (msPlayedEstimated = true).
  msPlayed          Int?
  msPlayedEstimated Boolean    @default(false)
  // Only RECENTLY_PLAYED has where it was played from (album/playlist/artist)
  contextType       String?
  contextUri        String?
  // Only EXPORT has the country it was played in (ISO code; the export's ZZ = unknown → null)
  country           String?
  source            PlaySource

  @@unique([userId, playedAt, trackId])
  @@index([userId, trackId])
}

model Track {
  id               String    @id @map("_id") // Spotify track id
  name             String
  artistIds        String[] // Spotify artist ids, main artist first
  albumId          String?
  durationMs       Int?
  // Set once filled in from Spotify. Tracks first seen in an export have only names until then.
  enrichedAt       DateTime?
  // From the export, used until enriched (or if Spotify no longer has the track)
  exportArtistName String?
  exportAlbumName  String?
}

model Artist {
  id         String    @id @map("_id") // Spotify artist id
  name       String
  imageUrl   String?
  genres     String[]
  // Set once images/genres are fetched; tracks only carry an artist's id and name
  enrichedAt DateTime?
}

model Album {
  id          String  @id @map("_id") // Spotify album id
  name        String
  imageUrl    String?
  releaseDate String? // as Spotify gives it: YYYY, YYYY-MM or YYYY-MM-DD
}

type PlayArtist {
  spotifyId String
  name      String
}

enum PlaySource {
  RECENTLY_PLAYED
  EXPORT
}

enum TimeRange {
  SHORT_TERM
  MEDIUM_TERM
  LONG_TERM
}
